{
  "name": "ros2-web-visualizer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:converter && vite build",
    "build:converter": "tsc -p tsconfig.tools.json && node tools/build-converter.mjs",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@foxglove/rosmsg": "5.0.5",
    "@foxglove/rosmsg2-serialization": "3.1.2",
    "@foxglove/ws-protocol": "0.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.177.0",
    "urdf-loader": "0.12.6",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.177.0",
    "playwright": "1.56.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "ws": "8.18.3"
  }
}
